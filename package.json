  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance",
    "widget",
    "deepseek-api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/x2802490130-prog/dsh-balance-float"
  },
